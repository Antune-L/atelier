FROM oven/bun:1.3.14-slim AS dependencies
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --ignore-scripts

FROM dependencies AS build
COPY src ./src
COPY tsconfig.json postcss.config.js tailwind.config.js ./
RUN bun run build:web

FROM oven/bun:1.3.14-slim AS runtime-dependencies
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production --omit optional --ignore-scripts

FROM oven/bun:1.3.14-slim AS preview
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*
COPY --from=runtime-dependencies --chown=bun:bun /app/node_modules ./node_modules
COPY --from=build --chown=bun:bun /app/dist/web ./dist/web
COPY --chown=bun:bun package.json ./
COPY --chown=bun:bun src/server ./src/server
COPY --chown=bun:bun src/shared ./src/shared
COPY --chown=bun:bun templates ./templates
COPY --chown=bun:bun skills ./skills
COPY --chown=bun:bun vendor/prd ./vendor/prd
COPY --chown=bun:bun .coolify/demo.config.json ./data/config.json
RUN mkdir -p /app/data/home && chown -R bun:bun /app/data
ENV NODE_ENV=production \
    HOME=/app/data/home \
    PORT=52817 \
    KANBAN_HOST=0.0.0.0 \
    KANBAN_DRY_RUN=1 \
    KANBAN_SETUP=0
USER bun
EXPOSE 52817
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 CMD bun -e 'const response = await fetch("http://127.0.0.1:" + process.env.PORT + "/health"); const body = await response.json(); process.exit(response.ok && body.ok === true && body.dryRun === true ? 0 : 1);'
CMD ["bun", "-e", "const { startServer } = await import('./src/server/index.ts'); await startServer({ dataRoot: '/app/data', resourcesRoot: '/app' });"]
