{
  "projects": {
    "my-project": {
      "label": "My Project",
      "repoPath": "/Users/me/my-project",
      "baseBranch": "main",
      "defaultAutoMerge": false,
      "defaultAddScreenshots": false,
      "commitTimeoutMs": 120000,
      "scripts": {
        "typecheck": "npm run typecheck",
        "lint": "npm run lint",
        "test": "npm test"
      },
      "worktreeScript": "npm run setup:worktree",
      "runScript": "npm run dev",
      "worktreeTeardownScript": "docker compose -f docker-compose.worktree.yml down -v --remove-orphans",
      "instructions": "(optional) project-specific instructions injected into the agent contract",
      "color": "#6366f1",
      "worktreePorts": [
        { "label": "frontend", "base": 3000 },
        { "label": "backend", "base": 3001 },
        { "label": "email", "base": 3002 }
      ]
    }
  },
  "models": {
    "implement": "opus",
    "triage": "sonnet",
    "implementEffort": "medium",
    "triageEffort": "low"
  }
}
